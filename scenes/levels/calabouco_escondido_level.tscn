[ext_resource type="Script" path="res://scripts/characters/npcs/dialogue_topic.gd" id="17_topic"]

[ext_resource type="PackedScene" path="res://scenes/characters/npcs/bone_kid.tscn" id="18_kid"]

[sub_resource type="Resource" id="DialogueTopic_1"]
script = ExtResource("17_topic")
watch = NodePath("../Navigation/Calabouco/Mecanismos/PortaoBiblioteca")
property = &"is_open"
at_least = 1
below = -1
lines = PackedStringArray("Aquela grade da biblioteca... Maelis. Maelis! Uma moça que brigava com os livros e ganhava. Acho que eu lembro dela.", "Ela me chamava de Michio-sem-norte. Eu achava carinhoso.")

[sub_resource type="Resource" id="DialogueTopic_2"]
script = ExtResource("17_topic")
watch = NodePath("../Navigation/Calabouco/Mecanismos/ParedeDaAdega")
property = &"is_broken"
at_least = 1
below = -1
lines = PackedStringArray("Cheiro de cerveja velha... Brakka? Um grandalhão que abria parede no giro. Ele me devia uma rodada. Ou eu devia pra ele.")

[sub_resource type="Resource" id="DialogueTopic_3"]
script = ExtResource("17_topic")
watch = NodePath("../Navigation/Calabouco/Mecanismos/CorredorDeFlechas")
property = &"is_armed"
at_least = 0
below = 1
lines = PackedStringArray("As flechas pararam? Aldren segurava essas rajadas no escudo e ainda reclamava do meu senso de direção.", "Sir Aldren sempre ia na frente. Por que eu não fui com ele?")

[sub_resource type="Resource" id="DialogueTopic_4"]
script = ExtResource("17_topic")
watch = NodePath("../Navigation/Calabouco/Mecanismos/PonteDoAbismo/Corda")
property = &"is_cut"
at_least = 1
below = -1
lines = PackedStringArray("A ponte desceu! Wren dizia que nada amarrado resiste a um bom virote. Ela me achava no escuro pelo barulho das espadas.")

[sub_resource type="Resource" id="DialogueTopic_5"]
script = ExtResource("17_topic")
watch = NodePath("../Navigation/Calabouco/Mecanismos/ParedeDaSalaSecreta")
property = &"is_broken"
at_least = 1
below = -1
lines = PackedStringArray("{Você achou|Vocês acharam} a última página do Aldren, não {achou|acharam}? Está na {sua cara|cara de vocês}. Tudo bem. Eu também ia ler.")

[sub_resource type="Resource" id="DialogueTopic_6"]
script = ExtResource("17_topic")
watch = NodePath("../Navigation/Calabouco/Mecanismos/PortaoDosSelos")
property = &"activations"
at_least = 0
below = 1
lines = PackedStringArray("Aquele portão lá embaixo, perto dos espinhos, tem dois selos. Um fede a osso, o outro a incenso. Eu fui pros dois lados. Por engano.")

[sub_resource type="Resource" id="DialogueTopic_7"]
script = ExtResource("17_topic")
watch = NodePath("../Navigation/Calabouco/Mecanismos/PortaoDosSelos")
property = &"activations"
at_least = 1
below = 2
lines = PackedStringArray("Um selo já foi! Falta o outro. Se um estava nos ossos, o outro deve estar onde se reza. Eu acho.")

[sub_resource type="Resource" id="DialogueTopic_8"]
script = ExtResource("17_topic")
watch = NodePath("../Navigation/Calabouco/Mecanismos/PortaoDosSelos")
property = &"activations"
at_least = 2
below = -1
lines = PackedStringArray("A descida abriu! Lá embaixo eu me perdi feio. Mais do que o normal.")

[sub_resource type="Resource" id="DialogueTopic_9"]
script = ExtResource("17_topic")
watch = NodePath("../Mimico")
property = &"is_dead"
at_least = 1
below = -1
lines = PackedStringArray("{Você matou|Vocês mataram} o baú que mordia? Passei semanas pedindo desculpa pra ele achando que era um baú normal.")

[sub_resource type="Resource" id="DialogueTopic_10"]
script = ExtResource("17_topic")
watch = NodePath("../Navigation/Calabouco/Interativos/BauDoTesouro")
property = &"is_open"
at_least = 1
below = -1
lines = PackedStringArray("{Achou|Acharam} o tesouro? O Lorde vai querer a parte dele. Ele sempre quer. Até da gente.")

[sub_resource type="Resource" id="DialogueTopic_11"]
script = ExtResource("17_topic")
watch = NodePath("../Navigation/Calabouco/Mecanismos/PortaoBiblioteca")
property = &"is_open"
at_least = 0
below = 1
lines = PackedStringArray("Tem uma biblioteca trancada perto do salão. Uma amiga minha entrava lá sem abrir porta nenhuma. Coisa de maga. Como era o nome dela...")

[sub_resource type="Resource" id="DialogueTopic_12"]
script = ExtResource("17_topic")
watch = NodePath("../Navigation/Calabouco/Mecanismos/ParedeDaAdega")
property = &"is_broken"
at_least = 0
below = 1
lines = PackedStringArray("Na sala da guarda tem uma parede rachada que cheira a cerveja. Espada não resolve. Machado girando, talvez.")

[sub_resource type="Resource" id="DialogueTopic_13"]
script = ExtResource("17_topic")
watch = NodePath("../Navigation/Calabouco/Mecanismos/CorredorDeFlechas")
property = &"is_armed"
at_least = 1
below = -1
lines = PackedStringArray("Aquele corredor que cospe flecha, ao lado da cripta? Só passa quem tem escudo e paciência. Eu não tenho nenhum dos dois.")

[sub_resource type="Resource" id="DialogueTopic_14"]
script = ExtResource("17_topic")
watch = NodePath("../Navigation/Calabouco/Mecanismos/PonteDoAbismo/Corda")
property = &"is_cut"
at_least = 0
below = 1
lines = PackedStringArray("Lá no fundo tem uma ponte erguida, presa por uma corda bem alta. Alta pra espada, sabe? Baixa pra uma besta.")

[sub_resource type="Resource" id="DialogueTopic_15"]
script = ExtResource("17_topic")
watch = NodePath("../Contagem")
property = &"remaining"
at_least = 12
below = -1
lines = PackedStringArray("Tem muito osso de pé ainda. Uns {valor}, se eu contei direito. Eu nunca conto direito.")

[sub_resource type="Resource" id="DialogueTopic_16"]
script = ExtResource("17_topic")
watch = NodePath("../Contagem")
property = &"remaining"
at_least = 2
below = 6
lines = PackedStringArray("Faltam {valor} mortos-vivos. Engraçado: toda vez que eu conto, sobra um que eu não acho.")

[sub_resource type="Resource" id="DialogueTopic_17"]
script = ExtResource("17_topic")
watch = NodePath("../Contagem")
property = &"remaining"
at_least = 1
below = 2
lines = PackedStringArray("Só falta um? Quem será... Olha, se for eu, não me conta agora.")

[sub_resource type="Resource" id="DialogueTopic_18"]
script = ExtResource("17_topic")
watch = NodePath("../Contagem")
property = &"remaining"
at_least = 1
below = -1
lines = PackedStringArray("O Lorde disse nenhum morto-vivo de pé. Nenhum, é? Regra rígida, essa.")

