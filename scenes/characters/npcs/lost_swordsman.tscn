[node name="EspadachimPerdido" node_paths=PackedStringArray("animation_player", "speech", "lantern", "talk_area", "prompt", "companion", "style_attacks", "drawn_blades", "sheathed_blades") instance=ExtResource("1_character")]
editor_description = "O espadachim perdido: morto-vivo carismatico que conversa com E, muda de andar junto com o grupo e conta como morto-vivo no contrato. Com a vida baixa saca as espadas da cintura, uma por estilo, e vira semi-boss. Falas no grupo Falas, golpes e limites no grupo Estilos."
collision_layer = 4
script = ExtResource("2_npc")
max_health = 12.0
animation_player = NodePath("Model/Esqueleto/AnimationPlayer")
speech = NodePath("Fala")
lantern = NodePath("Lanterna")
talk_area = NodePath("Conversa")
prompt = NodePath("Aviso")
companion = NodePath("Companheiro")
invite_line = "O que {você acha|vocês acham} de mais um no grupo? Eu ajudo na briga. E prometo não me perder. Muito."
accept_line = "Isso! A Companhia da... de alguma coisa, de volta à ativa! Vamos nessa, é por aqui."
decline_line = "Tudo bem, tudo bem. Eu pergunto de novo lá embaixo. Ou lá em cima. Onde for."
ally_hurt_line = "Ei! Eu tô do {seu lado|lado de vocês}!"
trap_line = "Ai! Quem botou isso aqui?! Que lugar mal-educado."
ahead_line = "Até que enfim! Eu cheguei primeiro, viu? Atalho."
style_attacks = [NodePath("Model/UmaEspada"), NodePath("Model/DuasEspadas"), NodePath("Model/TresEspadas")]
drawn_blades = [NodePath("Model/Esqueleto/Rig/Skeleton3D/MaoDireita/Espada"), NodePath("Model/Esqueleto/Rig/Skeleton3D/MaoEsquerda/Espada"), NodePath("Model/Esqueleto/Rig/Skeleton3D/Cabeca/EspadaNaBoca")]
sheathed_blades = [NodePath("Model/Esqueleto/Rig/Skeleton3D/Cintura/Bainha1"), NodePath("Model/Esqueleto/Rig/Skeleton3D/Cintura/Bainha2"), NodePath("Model/Esqueleto/Rig/Skeleton3D/Cintura/Bainha3")]
style_lines = PackedStringArray("Tá bom, tá bom... {você pediu|vocês pediram}. Estilo de uma espada!", "Duas espadas! Nada pessoal: é {o seu contrato|o contrato de vocês} contra a minha teimosia!", "Santoryuu! Estilo de três espadas! Agora é pra valer!")
startle_line = "Uepa! Pra que essa agressividade toda? Vamos com calma."
introduction = "Ah, gente viva! Que alegria. Eu sou Mayoi Michio. Michio quer dizer homem do caminho. Pode rir, todo mundo ri."
known_name = "Mayoi Michio"
floor_lines = Array[PackedStringArray]([PackedStringArray("Faz séculos que eu não converso com alguém que respira. {Conta|Contem} tudo: o sol ainda nasce lá em cima?", "Eu tô procurando a saída. Juro que era pra direita. Ou pra esquerda. Enfim, pra algum lado.", "Três espadas na cintura, sabe? Uma pra cada mão e uma pra boca. A da boca é pra emergência.", "{Você parece forte|Vocês parecem fortes}. {Se cuida|Se cuidem} lá embaixo, que o chão desse lugar tem dente."), PackedStringArray("{Você|Vocês} de novo! Eu sabia que a gente ia se encontrar. Eu também me perdi pra cá.", "Cuidado com os espinhos: eles sobem no ritmo. Conta até três e corre.", "Às vezes eu esqueço que também sou um deles. Mas eu não mordo. Quase nunca.", "Força! Quem chega até aqui já é mais corajoso que metade dos heróis que eu conheci."), PackedStringArray("Lanterna... Companhia da Lanterna. Por que esse nome me dá um aperto no peito? Se é que eu ainda tenho peito.", "Aquele Lorde mandou limpar tudo, não foi? Tudo, tudo mesmo?", "Se um dia {você tiver|vocês tiverem} que fazer o que tem que ser feito, eu vou entender. Só me {deixa|deixem} achar a saída antes.", "Foi bom {te conhecer|conhecer vocês}. Sério. Fazia tempo que eu não me sentia tão vivo.")])
hurt_lines = PackedStringArray("Ai! Isso doeu no osso.", "Ei, ei! Eu sou do bem!", "Tá bom, tá bom... eu entendi o recado.", "{Você vai|Vocês vão} mesmo fazer isso?")
death_line = "Tudo bem... o contrato é o contrato. {Acha|Achem} a saída por mim."

