[node name="OrdemDoLorde" parent="Historia" instance=ExtResource("19_note")]
position = Vector3(37.4, 0.0, 8.6)
text = "Ordem do Lorde, selada.\n\nLimpem o calabouço sob a vila. Pagamento na saída.\nCláusula única: nenhum morto-vivo fica de pé.\nQuem sair devendo um morto-vivo, deve a cabeça."

[node name="DiarioDia1" parent="Historia" instance=ExtResource("19_note")]
position = Vector3(30.8, 0.0, 29.2)
text = "Diário de Sir Aldren, Companhia da Lanterna.\n\nDia 1. Somos cinco: eu, Brakka, Maelis, Wren e o espadachim que se perde até em corredor reto.\nO Lorde pagou adiantado. Lorde nenhum paga adiantado."

[node name="BilheteMaelis" parent="Historia" instance=ExtResource("19_note")]
position = Vector3(47.0, 0.0, 40.8)
text = "Maelis, da Lanterna.\n\nEntrei pelo portal e a grade desceu atrás de mim. A alavanca abre por dentro, mas não tenho mais força.\nOs livros dizem: quem morre aqui levanta. O Lorde sabia. Ele não quer o calabouço limpo, quer a gente nele."

[node name="BilheteBrakka" parent="Historia" instance=ExtResource("19_note")]
position = Vector3(12.8, 0.0, 20.2)
text = "Brakka.\n\nA parede rachou no primeiro giro. Achei a adega do Lorde e bebi tudo. Valeu cada gole.\nSe vier outro bárbaro: o giro pesado derruba o que o resto do mundo chama de parede."

[node name="BilheteOssuario" parent="Historia" instance=ExtResource("19_note")]
position = Vector3(17.2, -4.0, 51.0)
text = "Contei os crânios. Quase todos têm marca de contrato no osso da testa.\nNão são aldeões. São os que vieram antes."

[node name="BilheteCapela" parent="Historia" instance=ExtResource("19_note")]
position = Vector3(84.0, -4.0, 61.2)
text = "Wren, da Lanterna.\n\nUm selo aqui no altar, outro entre os ossos. Os dois juntos abrem a descida.\nAldren foi pelas flechas, Maelis pela grade. Eu fico com as cordas: nada amarrado resiste a um bom virote."

[node name="DiarioArsenal" parent="Historia" instance=ExtResource("19_note")]
position = Vector3(29.2, -4.0, 76.8)
text = "Diário de Sir Aldren, último dia.\n\nO escudo aguentou as flechas até a alavanca. O resto de mim não aguentou o que veio depois.\nSe você carrega escudo, desligue a armadilha para os seus. Deixei o que sobrou do arsenal."

[node name="BilheteWren" parent="Historia" instance=ExtResource("19_note")]
position = Vector3(74.8, -6.0, 116.0)
text = "Wren.\n\nA ponte só desce se cortarem a corda lá no alto. Meu último virote errou.\nDo outro lado há uma galeria que sobe de volta à capela. Atalho para quem sobreviver. O seu não vai errar."

[node name="BilheteGaleria" parent="Historia" instance=ExtResource("19_note")]
position = Vector3(88.0, -6.0, 88.0)
text = "Riscado na pedra:\n\nSaída dos contratados. Quem chega aqui volta mais cedo para casa. Se ainda tiver casa."

[node name="UltimaPagina" parent="Historia" instance=ExtResource("19_note")]
position = Vector3(48.8, -8.0, 100.8)
text = "Última página de Sir Aldren.\n\nO espadachim foi para o lado errado de novo. Sempre volta. Desta vez voltou sem pulso, rindo como sempre.\nA cláusula não abre exceção. Se o encontrar, faça o que eu não tive coragem."

